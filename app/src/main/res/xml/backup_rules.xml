<?xml version="1.0" encoding="utf-8"?>
<!--
  系统备份排除规则（API 31 以下的 Auto Backup 用此文件）：
  - WebDAV 配置（含明文密码）不进备份
  - 剪贴板历史（独立库 clipboard_database）不进备份
  - 日志与下载缓存（external 的 log/、download/）不进备份
  - 语音纠错表（filesDir 根下 voice_corrections.tsv，含用户改词记录）不进备份
  - 还原中断快照（filesDir 根下 restore-snapshot.jbk，含剪贴板/常用语全量数据）不进备份
  - 搭配学习表（filesDir 根下 user_collocations.tsv，由打字习惯派生的词对）不进备份
  - 崩溃自捕获文件（filesDir/crash/ 子目录，含异常堆栈）不进备份
  - 设备本地状态偏好（speech_model_prefs、wanxiang_update：下载/更新
    记录与本机文件绑定，带去新设备会让检查误判「已装/已最新」）不进备份
  其余（用户词典、主题、设置、常用语、选词偏好等）照常备份，不影响换机迁移。
-->
<full-backup-content>
    <exclude domain="sharedpref" path="user_dict_sync.xml" />
    <exclude domain="sharedpref" path="speech_model_prefs.xml" />
    <exclude domain="sharedpref" path="wanxiang_update.xml" />
    <exclude domain="external" path="shared/" />
    <exclude domain="external" path="model/" />
    <exclude domain="external" path="log/" />
    <exclude domain="external" path="download/" />
    <exclude domain="file" path="voice_corrections.tsv" />
    <exclude domain="file" path="voice_corrections.tsv.tmp" />
    <exclude domain="file" path="restore-snapshot.jbk" />
    <exclude domain="file" path="restore-snapshot.jbk.tmp" />
    <exclude domain="file" path="user_collocations.tsv" />
    <exclude domain="file" path="user_collocations.tsv.tmp" />
    <!-- 崩溃自捕获文件（filesDir/crash/ 子目录，按进程一份；按目录整体排除，新增进程不漏） -->
    <exclude domain="file" path="crash/" />
    <exclude domain="database" path="clipboard_database" />
    <exclude domain="database" path="clipboard_database-wal" />
    <exclude domain="database" path="clipboard_database-shm" />
    <exclude domain="database" path="clipboard_database-journal" />
</full-backup-content>
