<?xml version="1.0" encoding="utf-8"?>
<!--
  数据提取规则（API 31+）：云备份与设备迁移都排除敏感内容：
  - WebDAV 配置（含明文密码）
  - 剪贴板历史（独立库 clipboard_database）
  其余（用户词典、主题、设置、常用语、选词偏好等）照常迁移。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="user_dict_sync.xml" />
        <exclude domain="database" path="clipboard_database" />
        <exclude domain="database" path="clipboard_database-wal" />
        <exclude domain="database" path="clipboard_database-shm" />
        <exclude domain="database" path="clipboard_database-journal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="user_dict_sync.xml" />
        <exclude domain="database" path="clipboard_database" />
        <exclude domain="database" path="clipboard_database-wal" />
        <exclude domain="database" path="clipboard_database-shm" />
        <exclude domain="database" path="clipboard_database-journal" />
    </device-transfer>
</data-extraction-rules>
